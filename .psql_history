\dt
\dt
CREATE TABLE IF NOT EXISTS users (  uid TEXT PRIMARY KEY,  email TEXT,  display_name TEXT,  photo_url TEXT);CREATE TABLE IF NOT EXISTS exchange_connections (  id TEXT PRIMARY KEY,  user_id TEXT NOT NULL,  exchange TEXT NOT NULL,  encrypted_api_key TEXT NOT NULL,  encrypted_secret_key TEXT NOT NULL,  encrypted_passphrase TEXT,  api_key_masked TEXT,  status TEXT NOT NULL,  is_live_trading_enabled INTEGER NOT NULL DEFAULT 0,  created_at TIMESTAMPTZ DEFAULT NOW(),  updated_at TIMESTAMPTZ DEFAULT NOW());CREATE TABLE IF NOT EXISTS user_bots (  id TEXT PRIMARY KEY,  user_id TEXT NOT NULL,  name TEXT NOT NULL,  exchange TEXT NOT NULL,  strategy TEXT NOT NULL,  pair TEXT NOT NULL,  capital REAL NOT NULL,  status TEXT NOT NULL,  updated_at TIMESTAMPTZ DEFAULT NOW());CREATE INDEX IF NOT EXISTS idx_exchange_connections_user  ON exchange_connections(user_id);CREATE INDEX IF NOT EXISTS idx_user_bots_user  ON user_bots(user_id);
\dt
\q
BEGIN READ ONLY;SELECT table_nameFROM information_schema.tablesWHERE table_schema = 'public'ORDER BY table_name;SELECT 'exchange_connections' AS table_name, COUNT(*) AS row_countFROM public.exchange_connectionsUNION ALLSELECT 'user_bots', COUNT(*)FROM public.user_botsUNION ALLSELECT 'users', COUNT(*)FROM public.users;ROLLBACK;
\q
BEGIN READ ONLY;SELECT uid, emailFROM public.usersORDER BY email;SELECT id, user_id, exchange, status, is_live_trading_enabledFROM public.exchange_connections;SELECT id, user_id, name, exchange, pair, statusFROM public.user_botsORDER BY id;ROLLBACK;
\q
BEGIN;DELETE FROM public.usersWHERE uid = 'c9sw7gYiaphYAB9gjJtguCk1CwL2'  AND lower(email) = lower('piyumanjaleeoshi@gmail.com')RETURNING uid, email;
COMMIT;
\q
SELECT uid, emailFROM public.usersORDER BY email;
\q
