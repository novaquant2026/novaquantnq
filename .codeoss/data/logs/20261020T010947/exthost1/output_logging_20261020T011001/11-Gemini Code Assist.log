I1020 01:20:33.868255    2285 conn_opt.go:53] jsonrpc2: --> notif: textDocument/didOpen: {"textDocument":{"uri":"file:///home/piyumanjaleeoshi/novaquant/server/autonomousEngine.ts","languageId":"typescript","version":1,"text":"import http from 'http';\n\nlet isRunning = false;\nlet consecutiveFailures = 0;\nlet cooldownUntil = 0;\n\nfunction postJson(port: number, path: string, body: any): Promise\u003cany\u003e {\n  return new Promise((resolve, reject) =\u003e {\n    const payload = JSON.stringify(body || {});\n    const req = http.request(\n      {\n        hostname: '127.0.0.1',\n        port,\n        path,\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'Content-Length': Buffer.byteLength(payload),\n        },\n        timeout: 15000,\n      },\n      (res) =\u003e {\n        let data = '';\n        res.on('data', (chunk) =\u003e (data += chunk));\n        res.on('end', () =\u003e {\n          try {\n            resolve({ status: res.statusCode || 500, data: data ? JSON.parse(data) : {} });\n          } catch {\n            resolve({ status: res.statusCode || 500, data: {} });\n          }\n        });\n      }\n    );\n    req.on('error', reject);\n    req.on('timeout', () =\u003e {\n      req.destroy();\n      reject(new Error(`Timeout calling ${path}`));\n    });\n    req.write(payload);\n    req.end();\n  });\n}\n\nfunction getJson(port: number, path: string): Promise\u003cany\u003e {\n  return new Promise((resolve, reject) =\u003e {\n    const req = http.get(\n      {\n        hostname: '127.0.0.1',\n        port,\n        path,\n        timeout: 10000,\n      },\n      (res) =\u003e {\n        let data = '';\n        res.on('data', (chunk) =\u003e (data += chunk));\n        res.on('end', () =\u003e {\n          try {\n            resolve({ status: res.statusCode || 500, data: data ? JSON.parse(data) : {} });\n          } catch {\n            resolve({ status: res.statusCode || 500, data: {} });\n          }\n        });\n      }\n    );\n    req.on('error', reject);\n    req.on('timeout', () =\u003e {\n      req.destroy();\n      reject(new Error(`Timeout calling ${path}`));\n    });\n  });\n}\n\nexport function startAutonomousEngine(port: number = 3000, intervalMs: number = 10000) {\n  console.log(`[AutonomousEngine] Initialized (polling every ${intervalMs}ms on port ${port})`);\n\n  setInterval(async () =\u003e {\n    if (isRunning) return;\n    if (Date.now() \u003c cooldownUntil) return;\n\n    isRunning = true;\n    try {\n      const stateRes = await getJson(port, '/api/state');\n      const state = stateRes?.data;\n      if (!state || state.botStatus !== 'RUNNING') {\n        isRunning = false;\n        return;\n      }\n\n      const symbol = state.activeSymbol || 'BTC/USDT';\n      const aiRes = await postJson(port, '/api/ai/analyze', { symbol });\n      if (aiRes.status !== 200 || !aiRes.data) {\n        throw new Error('AI analysis endpoint failed');\n      }\n\n      const ai = aiRes.data;\n      const consensusRes = await postJson(port, '/api/consensus', {\n        openai_decision: ai.openai?.decision || ai.openai_decision || 'HOLD',\n        gemini_decision: ai.gemini?.decision || ai.gemini_decision || 'HOLD',\n        technical_decision: ai.technical?.decision || ai.technical_decision || 'HOLD',\n        openai_confidence: ai.openai?.confidence ?? ai.openai_confidence ?? 0,\n        gemini_confidence: ai.gemini?.confidence ?? ai.gemini_confidence ?? 0,\n        technical_confidence: ai.technical?.confidence ?? ai.technical_confidence ?? 0,\n      });\n\n      const consensus = consensusRes?.data;\n      if (!consensus || !consensus.approved || consensus.final_decision === 'HOLD') {\n        consecutiveFailures = 0;\n        isRunning = false;\n        return;\n      }\n\n      const riskRes = await postJson(port, '/api/risk/check', {\n        symbol,\n        direction: consensus.final_decision,\n        confidence: consensus.combined_confidence || 80,\n      });\n\n      if (riskRes?.data?.approved) {\n        await postJson(port, '/api/trades/open', {\n          symbol,\n          direction: consensus.final_decision,\n          confidence: consensus.combined_confidence || 80,\n        });\n      }\n\n      consecutiveFailures = 0;\n    } catch (err: any) {\n      consecutiveFailures++;\n      console.warn(`[AutonomousEngine] Cycle error (${consecutiveFailures}):`, err?.message || err);\n      if (consecutiveFailures \u003e= 5) {\n        cooldownUntil = Date.now() + 60000;\n        console.warn('[AutonomousEngine] Entering 60s cooldown due to repeated failures.');\n        consecutiveFailures = 0;\n      }\n    } finally {\n      isRunning = false;\n    }\n  }, intervalMs);\n}\n"}}
