I1020 01:19:11.965390    2285 conn_opt.go:53] jsonrpc2: --> notif: textDocument/didChange: {"textDocument":{"uri":"file:///home/piyumanjaleeoshi/novaquant/server.ts","version":5},"contentChanges":[{"range":{"start":{"line":1439,"character":0},"end":{"line":1502,"character":0}},"rangeLength":2911,"text":"// 4. POST /api/consensus - Gemini + Technical Only\napp.post('/api/consensus', (req, res) =\u003e {\n  const {\n    openai_decision = 'HOLD',\n    gemini_decision,\n    technical_decision,\n    openai_confidence = 0,\n    gemini_confidence = 0,\n    technical_confidence = 0\n  } = req.body;\n\n  let final_consensus: ConsensusDecision = 'NO TRADE';\n  let approved_for_risk_check = false;\n  let consensusScore = 0;\n  let reasoning = '';\n\n  const op = openai_decision || 'HOLD';\n  const gem = gemini_decision || 'HOLD';\n  const tech = technical_decision || 'HOLD';\n\n  // Gemini-only rule set:\n  // 1) Gemini + Technical agree = execute\n  // 2) Gemini alone can trigger if technical is neutral or aligned\n  // 3) conflicting signals = NO TRADE\n  if (gem === 'LONG' \u0026\u0026 tech === 'LONG') {\n    final_consensus = 'LONG';\n    approved_for_risk_check = true;\n    consensusScore = Math.round(((gemini_confidence || 80) + (technical_confidence || 75)) / 2);\n    reasoning = 'Gemini and Technical Analysis agree on LONG. Auto-trade approved.';\n  } else if (gem === 'SHORT' \u0026\u0026 tech === 'SHORT') {\n    final_consensus = 'SHORT';\n    approved_for_risk_check = true;\n    consensusScore = Math.round(((gemini_confidence || 80) + (technical_confidence || 75)) / 2);\n    reasoning = 'Gemini and Technical Analysis agree on SHORT. Auto-trade approved.';\n  } else if (gem === 'LONG' \u0026\u0026 tech !== 'SHORT') {\n    final_consensus = 'LONG';\n    approved_for_risk_check = true;\n    consensusScore = 72;\n    reasoning = 'Gemini bullish and technical is not bearish. Approved with caution.';\n  } else if (gem === 'SHORT' \u0026\u0026 tech !== 'LONG') {\n    final_consensus = 'SHORT';\n    approved_for_risk_check = true;\n    consensusScore = 72;\n    reasoning = 'Gemini bearish and technical is not bullish. Approved with caution.';\n  } else {\n    final_consensus = 'NO TRADE';\n    approved_for_risk_check = false;\n    consensusScore = 35;\n    reasoning = `Gemini (${gem}) and Technical Analysis (${tech}) conflict. Trade blocked for safety.`;\n  }\n\n  const result: AIConsensusResult = {\n    openai_decision: op,\n    gemini_decision: gem,\n    technical_decision: tech,\n    final_consensus,\n    approved_for_risk_check,\n    consensusScore,\n    weights: {\n      openai: 0,\n      gemini: 0.6,\n      technical: 0.4,\n    },\n    reasoning,\n    timestamp: Date.now(),\n  };\n\n  res.json(result);\n});"}]}
